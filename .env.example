# UmmahAPI (Get your free key from ummahapi.com)
UMMAH_API_KEY=your_ummah_api_key_here
UMMAH_API_BASE_URL=https://ummahapi.com/api

# Google Gemini API for High-Precision Multimodal Timetable OCR
# Get your free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API for Fast (<400ms) Vision AI Fallback
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Cloudflare Turnstile Spam & Bot Protection (Database Security)
# Obtain your keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Default test keys:
# Site Key: 1x00000000000000000000AA (always passes)
# Secret Key: 1x0000000000000000000000000000000AA (always passes)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Admin Console Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SESSION_SECRET=your_random_session_secret_here

# Supabase Authentication & Database (Recommended)
# Obtain from https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
